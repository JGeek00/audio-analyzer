    "Fast" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rápido"
          }
        }
      }
    },
    "Files written at once when saving metadata. Responsive writes one at a time and keeps the app smooth; Fast writes up to four at once." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos que se escriben a la vez al guardar metadatos. Reactivo escribe uno a la vez y mantiene la app fluida; Rápido escribe hasta cuatro a la vez."
          }
        }
      }
    },
    "Gain is applied by the player at playback time. Changing these values updates the ReplayGain column instantly, without re-analyzing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ganancia la aplica el reproductor durante la reproducción. Cambiar estos valores actualiza al instante la columna ReplayGain, sin reanalizar."
          }
        }
      }
    },
    "General" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General"
          }
        }
      }
    },
    "Halve BPM" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
