      }
    },
    "Reference loudness. Each track's gain is target minus measured loudness. −18 LUFS matches classic ReplayGain; streaming services use −14 to −16." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonoridad de referencia. La ganancia de cada pista es el objetivo menos la sonoridad medida. −18 LUFS corresponde al ReplayGain clásico; los servicios de streaming usan de −14 a −16."
          }
        }
      }
    },
