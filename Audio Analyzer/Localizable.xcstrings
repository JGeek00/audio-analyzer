    "Low performance mode" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo de bajo rendimiento"
          }
        }
      }
    },
    "Low performance mode reduces waveform resolution and refresh rate to improve performance on less powerful Macs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de bajo rendimiento reduce la resolución de la forma de onda y la frecuencia de actualización para mejorar el rendimiento en los Mac menos potentes."
          }
        }
      }
    },
    "Lowers the calculated gain when applying it would push peaks over Max Peak. Positive-only protects loud tracks without touching quiet ones." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce la ganancia calculada cuando aplicarla superaría el Pico máximo. Solo positivos protege las pistas altas sin tocar las suaves."
          }
        }
      }
    },
    "LUFS" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LUFS"
